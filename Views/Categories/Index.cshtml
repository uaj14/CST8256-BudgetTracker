@model IEnumerable<CST8256_BudgetTracker.DataAccess.Category>

@{
    ViewData["Title"] = "Index";
}

<h1>Categories</h1>

<p>
    <a asp-action="Create"><img src="~/icons/Notebook.ico" width="32" height="32" alt="Create New"></a>
</p>
<table class="table uitable">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id"><img src="~/icons/xp edit.ico" alt="Edit"></a> 
                <a asp-action="Details" asp-route-id="@item.Id"><img src="~/icons/File.ico" width="32" height="32" alt="Details"></a> 
                <a asp-action="Delete" asp-route-id="@item.Id"><img src="~/icons/Empty Recycle Bin.ico" width="32" height="32" alt="Delete"></a>
            </td>
        </tr>
}
    </tbody>
</table>
