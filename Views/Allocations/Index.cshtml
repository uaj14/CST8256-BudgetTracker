@model IEnumerable<CST8256_BudgetTracker.DataAccess.Allocation>

@{
    ViewData[index: "Title"] = "Index";
}

<h1>Allocations</h1>

<p>
    <a asp-action="Create"><img src="~/icons/Notebook.ico" width="32" height="32" alt="Create New"></a>
</p>
<table class="table uitable">
    <thead>
        <tr>
            <th>
                @* <a asp-route-sort="AllocationAmount">@Html.DisplayNameFor(model => model.AllocationAmount)</a> *@
                <a asp-route-sort="@ViewBag.AllocationAmount_sort">@Html.DisplayNameFor(model => model.AllocationAmount)</a>
            </th>
            <th>
                <a asp-route-sort="@ViewBag.AllocationMonth_sort">@Html.DisplayNameFor(model => model.AllocationMonth)</a>
            </th>
            <th>
                <a asp-route-sort="@ViewBag.CreatedAt_sort">@Html.DisplayNameFor(model => model.CreatedAt)</a>
            </th>
            <th>
                <a asp-route-sort="@ViewBag.UpdatedAt_sort">@Html.DisplayNameFor(model => model.UpdatedAt)</a>
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.AllocationAmount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AllocationMonth)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category.Id)
            </td>
            <td class="d-flex">
                <a asp-action="Edit" asp-route-id="@item.Id" class="me-1"><img src="~/icons/xp edit.ico" alt="Edit"></a> 
                <form asp-action="Delete" class="d-flex ms-1" onsubmit="return confirm('Are you sure you want to delete this item?')">
                    <input type="hidden" name="id" value="@item.Id" />
                    <button type="submit" class="btn btn-link p-0"><img src="~/icons/Empty Recycle Bin.ico" width="32" height="32" alt="Delete"></button>
                </form>
                @* <a asp-action="Delete" asp-route-id="@item.Id">Delete</a> *@
            </td>
        </tr>
}
    </tbody>
</table>
