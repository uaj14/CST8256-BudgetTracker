@* @model IEnumerable<CST8256_BudgetTracker.DataAccess.Allocation> *@
@model CST8256_BudgetTracker.Models.AllocationIndexViewModel

@{
    ViewData[index: "Title"] = "Index";
}

<h1>Allocations</h1>

<p>
    <a asp-action="Create"><img src="~/icons/Notebook.ico" width="32" height="32" alt="Create New"></a>
</p>
<form asp-action="Index" method="get">
    <div class="form-group">
        <label asp-for="SelectedAllocationMonth" class="control-label"></label>
        <select asp-for="SelectedAllocationMonth" 
            class ="form-select" 
            asp-items="@Model.AllocationMonthOptions"
            onchange="this.form.submit()">
        </select>
        <span asp-validation-for="SelectedAllocationMonth" class="text-danger"></span>
    </div>
</form>
<table class="table uitable">
    <thead>
        <tr>
            <th>
                <a asp-route-sort="@ViewBag.AllocationMonth_sort">Allocation Month</a>
            </th>
            <th>
                Category
            </th>
            <th>
                <a asp-route-sort="@ViewBag.AllocationAmount_sort">Allocation Amount</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Allocations) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.AllocationMonth)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AllocationAmount)
            </td>
            <td class="d-flex">
                @if (item.AllocationMonth == new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1)) {
                    <a asp-action="Edit" asp-route-id="@item.Id" class="me-1"><img src="~/icons/xp edit.ico" alt="Edit"></a> 
                    <form asp-action="Delete" class="d-flex ms-1" onsubmit="return confirm('Are you sure you want to delete this item?')">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-link p-0"><img src="~/icons/Empty Recycle Bin.ico" width="32" height="32" alt="Delete"></button>
                    </form>
                    @* <a asp-action="Delete" asp-route-id="@item.Id">Delete</a> *@
                }
                else
                {
                    <p>Archived</p>
                }
                
            </td>
        </tr>
}
    </tbody>
</table>
