@* @model IEnumerable<CST8256_BudgetTracker.DataAccess.Transaction> *@
@model IEnumerable<CST8256_BudgetTracker.Models.TransactionListItemViewModel>
@{
    ViewData["Title"] = "Index";
}

<h1>Transaction</h1>

<p>
    <a asp-action="Create"><img src="~/icons/Notebook.ico" width="32" height="32" alt="Create New"></a>
</p>
<table class="table uitable">
    <thead>
        <tr>
            <th>
                @* <a asp-route-sort="@ViewBag.TransactionDate_sort">@Html.DisplayNameFor(model => model.TransactionDate)</a> *@
                <a asp-route-sort="@ViewBag.Date_sort">@Html.DisplayNameFor(model => model.Date)</a>
            </th>
            <th>
                <a asp-route-sort="@ViewBag.Description_sort">@Html.DisplayNameFor(model => model.Description)</a>
            </th>
            <th>
                <a asp-route-sort="@ViewBag.Amount_sort">@Html.DisplayNameFor(model => model.Debit)</a>
            </th>
            <th>
                <a asp-route-sort="@ViewBag.Amount_sort">@Html.DisplayNameFor(model => model.Credit)</a>
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @* @Html.DisplayFor(modelItem => item.TransactionDate) *@
                @Html.DisplayFor(modelItem => item.Date)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @if (item.Debit != 0) // Suggested by AI: Using if statement to show blank items for 0 values.
                {
                    @Html.DisplayFor(modelItem => item.Debit)
                }
            </td>
            <td>
                @if (item.Credit != 0)
                {
                    @Html.DisplayFor(modelItem => item.Credit)
                }
            </td>
            <td class="d-flex">
                <a asp-action="Edit" asp-route-id="@item.Id" class="me-1"><img src="~/icons/xp edit.ico" alt="Edit"></a> 
                <form asp-action="Delete" class="d-flex ms-1" onsubmit="return confirm('Are you sure you want to delete this item?')">
                    <input type="hidden" name="id" value="@item.Id" />
                    <button type="submit" class="btn btn-link p-0"><img src="~/icons/Empty Recycle Bin.ico" width="32" height="32" alt="Delete"></button>
                </form>
                @* <a asp-action="Delete" asp-route-id="@item.Id">Delete</a> *@
            </td>
        </tr>
}
    </tbody>
</table>
